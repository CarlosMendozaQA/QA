script:pre-request {
  const sequenceNumber = Date.now();
  
  bru.setVar("dynamicSequenceNumber", sequenceNumber);
  
  console.log("dynamicSequenceNumber:", sequenceNumber);
}

script:post-response {
  const jsonData = res.getBody();
  
  test("Cancelación aprobada", function () {
      expect(jsonData.dataCommand.responseMessage).to.equal("APROBADA");
  });
  
  if (jsonData?.dataCommand?.responseMessage !== "APROBADA") {
      console.error("❌ Cancelación falló", {
          response: jsonData
      });
  } else {
      console.log("✅ Cancelación exitosa", {
          approvalCode: jsonData.dataCommand.approvalCode,
          rrn: jsonData.dataCommand.rrn
      });
  }
  
  bru.setNextRequest(null);
}

settings {
  encodeUrl: true
  timeout: 0
}
