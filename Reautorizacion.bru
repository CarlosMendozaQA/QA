meta {
  name: Reautorizacion
  type: http
  seq: 9
}

post {
  url: https://api.qa.stg.smartpayment.com.mx/iot-gateway/transaction
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-api-key: Ai7CQBv4LB2lmo6MyEQ8C5qubsyvMUHW5stlFBZv
  Accept: application/json
}

body:json {
  {
    "code": "1009",
    "sequenceNo": "{{seq}}",
    "siteId": "{{siteId}}",
    "wsNo": "{{wsNo}}",
    "posInfo": "{{posInfo}}",
    "dataTransaction": {
      "originalTxCode": "1007",
      "originalSeqNo": "{{originalSeqNo}}",
      "txnDate": "{{txnDate}}",
      "tipAmount": "0.00",
      "tipOnPinpad": false,
      "promoOnPinpad": true,
      "transAmount": "19.78",
      "transCurrency": "484",
      "cardPresent": false,
      "allowManualEntry": false,
      "approvalCode": "{{approvalCode}}",
      "originalRnn": "{{originalRrn}}",
      "maskedPan": "{{maskedPan}}"
    }
  }
}

body:xml {
  {
    "code": "1007",
    "sequenceNo": "{{dynamicSequenceNumber}}",
    "siteId": "{{siteID}}",
    "wsNo": "{{serialNumber}}",
    "posInfo": "BrunoRequest",
    "dataTransaction": {
      "transAmount": "{{transactionAmount}}",
      "tipAmount": "0.00",
      "tipOnPinpad": false,
      "promoOnPinpad": false,
      "transCurrency": "484",
      "cardPresent": true
    }
  }
}

vars:pre-request {
  siteID: COMIDURHC6PK
}

script:pre-request {
  bru.setVar("seq", Date.now().toString().slice(-8));
}

script:post-response {
  function findKey(obj, key) {
    if (obj && typeof obj === "object") {
      if (key in obj) return obj[key];
      for (const k of Object.keys(obj)) {
        const found = findKey(obj[k], key);
        if (found !== undefined) return found;
      }
    }
  }
  
  const reauthCents = parseInt(findKey(res.body, "txnAmount"), 10);
  const prevCents = parseInt(bru.getVar("totalCents") || "0", 10);
  const newCents = prevCents + reauthCents;
  
  bru.setVar("totalCents", newCents);
  bru.setVar("totalAmount", (newCents / 100).toFixed(2));
}

settings {
  encodeUrl: true
  timeout: 0
}
