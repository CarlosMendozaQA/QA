  "item": [
    {
      "name": "Venta",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "if (jsonData?.dataCommand?.responseMessage === \"APROBADA\") {",
              "",
              "    // Guardar variables (ya lo tienes)",
              "    pm.collectionVariables.set(\"originalSequenceNumber\", pm.collectionVariables.get(\"dynamicSequenceNumber\"));",
              "    pm.collectionVariables.set(\"transactionDate\", jsonData.dataCommand.txnDate);",
              "    pm.collectionVariables.set(\"approvalCode\", jsonData.dataCommand.approvalCode);",
              "    pm.collectionVariables.set(\"transactionAmount\", (Number(jsonData.dataCommand.txnAmount) / 100).toFixed(2));",
              "    pm.collectionVariables.set(\"maskedPan\", jsonData.dataCommand.accountNumber);",
              "    pm.collectionVariables.set(\"originalRNN\", jsonData.dataCommand.rrn);",
              "",
              "    // DECISIÓN DEL FLUJO 🎯",
              "    let flujo = pm.environment.get(\"flujo\"); ",
              "    // valores posibles: reverso, cancelacion, devolucion, consulta",
              "",
              "    if (flujo === \"reverso\") {",
              "        postman.setNextRequest(\"Reverso\");",
              "    } else if (flujo === \"cancelacion\") {",
              "        postman.setNextRequest(\"Cancelación\");",
              "    } else if (flujo === \"devolucion\") {",
              "        postman.setNextRequest(\"Devolución\");",
              "    } else {",
              "        postman.setNextRequest(\"Consulta\");",
              "    }",
              "",
              "} else {",
              "    postman.setNextRequest(null);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
